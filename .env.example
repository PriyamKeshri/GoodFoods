# Model profile: ollama-llama3.1-8b | ollama-qwen3-8b | groq-llama-3.1-8b | openrouter-llama-3.3-8b | custom
LLM_PROFILE=ollama-llama3.1-8b

# Hosted options (fast, free tiers available)
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Any other OpenAI-compatible endpoint (Meta Llama API, vLLM, Together...)
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=

# Freeze the clock for demos/evals
# GOODFOODS_NOW=2026-11-15T18:00

# Hide the local Ollama models (for servers without Ollama, e.g. Streamlit Community Cloud)
# SHOW_LOCAL_MODELS=false
